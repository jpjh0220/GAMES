{
  "name": "games-1000x",
  "version": "2.0.0",
  "description": "Earthbound 3D game + Sol autonomous AI agent (1000x upgrade)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:game": "vite build --config vite.game.ts",
    "build:agent": "bun build sol-live/sol-live.ts --outfile dist/agent.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "analyze": "vite build --analyze"
  },
  "dependencies": {
    "three": "^r185",
    "pino": "^8.16.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4",
    "date-fns": "^2.30.0",
    "lru-cache": "^10.1.0",
    "workerpool": "^9.1.3"
  },
  "devDependencies": {
    "vite": "^5.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.17.4",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "esbuild": "^0.19.11",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "bun": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
